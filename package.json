{
  "name": "open-seat",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "description": "",
  "main": "index.js",
  "scripts": {
    "db": "docker compose up -d",
    "db:stop": "docker compose stop",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "seed": "npm run seed --prefix backend",
    "build": "npm install --prefix backend && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "start": "node backend/src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atharva-026/open-seat.git"
  },
